<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Express Auth</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav>
        <div class="nav-wrapper container">
            <a href="/" class="brand-logo">🚀 ExpressAuth</a>
            <ul class="right">
                <li><a href="/profile"><i class="material-icons left">person</i>Mi Cuenta</a></li>
                <li><a href="/logout"><i class="material-icons left">exit_to_app</i>Cerrar Sesión</a></li>
            </ul>
        </div>
    </nav>

    <main class="container" style="margin-top: 60px;">
        <div style="text-align: center; margin-bottom: 60px;">
            <h4 class="page-title" style="font-size: 3rem;">Dashboard de Usuario</h4>
            <p style="color: rgba(255,255,255,0.9); font-size: 1.2rem; font-weight: 300;">Gestiona tu información personal</p>
        </div>

        <div class="row">
            <div class="col s12 m6">
                <div class="stats-card">
                    <p style="margin: 0; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 700;">Bienvenido</p>
                    <h5 style="font-size: 2.8rem; font-weight: 900; margin: 15px 0; letter-spacing: -1px;"><%= user.name %> <%= user.lastName || '' %></h5>
                    <p style="opacity: 0.95; margin: 0; font-size: 1.1rem;"><i class="material-icons left" style="font-size: 1.3rem;">email</i><%= user.email %></p>
                </div>
            </div>
            <div class="col s12 m6">
                <div class="card" style="border-radius: 24px; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
                    <div class="card-content" style="padding: 40px;">
                        <span class="card-title" style="color: #f1f5f9; font-weight: 800; font-size: 1.9rem; margin-bottom: 30px;">Tus Datos</span>
                        <div style="margin-top: 20px;">
                            <div class="info-card" style="margin-bottom: 15px;">
                                <i class="material-icons">phone</i>
                                <div style="flex: 1;">
                                    <p style="color: #60a5fa; margin: 0 0 5px 0; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; font-weight: 700;">Teléfono</p>
                                    <p style="color: #e2e8f0; margin: 0; font-weight: 600; font-size: 1.1rem;"><%= user.phoneNumber || 'No especificado' %></p>
                                </div>
                            </div>
                            <div class="info-card" style="margin-bottom: 15px;">
                                <i class="material-icons">event</i>
                                <div style="flex: 1;">
                                    <p style="color: #60a5fa; margin: 0 0 5px 0; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; font-weight: 700;">Registro</p>
                                    <p style="color: #e2e8f0; margin: 0; font-weight: 600; font-size: 1.1rem;"><%= new Date(user.createdAt).toLocaleDateString() %></p>
                                </div>
                            </div>
                            <div class="info-card">
                                <i class="material-icons">badge</i>
                                <div style="flex: 1;">
                                    <p style="color: #60a5fa; margin: 0 0 10px 0; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; font-weight: 700;">Rol</p>
                                    <p style="margin: 0;">
                                        <% user.roles.forEach(role => { %>
                                            <span class="role-badge <%= role === 'admin' ? 'admin' : 'user' %>">
                                                <%= role %>
                                            </span>
                                        <% }) %>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-action" style="text-align: center; padding: 25px 40px; background: rgba(15, 23, 42, 0.5);">
                        <a href="/profile" style="color: #60a5fa; font-weight: 600; font-size: 1.1rem;"><i class="material-icons left">edit</i>Editar Perfil</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row" style="margin-top: 40px;">
            <div class="col s12">
                <div class="card" style="border-radius: 24px; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
                    <div class="card-content" style="padding: 40px;">
                        <span class="card-title" style="color: #f1f5f9; font-weight: 800; font-size: 1.9rem; margin-bottom: 30px;">Acciones Rápidas</span>
                        <div class="row" style="margin-top: 20px;">
                            <div class="col s12 m4">
                                <a href="/profile" class="action-card">
                                    <i class="material-icons">person</i>
                                    <p style="margin: 10px 0 0 0; font-weight: 600; font-size: 1.2rem;">Mi Perfil</p>
                                </a>
                            </div>
                            <div class="col s12 m4">
                                <a href="/profile" class="action-card" style="background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);">
                                    <i class="material-icons">edit</i>
                                    <p style="margin: 10px 0 0 0; font-weight: 600; font-size: 1.2rem;">Editar Datos</p>
                                </a>
                            </div>
                            <div class="col s12 m4">
                                <a href="/logout" class="action-card" style="background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);">
                                    <i class="material-icons">exit_to_app</i>
                                    <p style="margin: 10px 0 0 0; font-weight: 600; font-size: 1.2rem;">Cerrar Sesión</p>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="page-footer" style="margin-top: 80px;">
        <div class="footer-copyright">
            <div class="container">© 2026 Express Mongo Auth</div>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>