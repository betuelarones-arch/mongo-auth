<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Express Auth</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav>
        <div class="nav-wrapper container">
            <a href="/" class="brand-logo">🚀 ExpressAuth</a>
            <ul class="right">
                <li><a href="/dashboard"><i class="material-icons left">dashboard</i>Dashboard</a></li>
                <li><a href="/profile"><i class="material-icons left">person</i>Mi Cuenta</a></li>
                <li><a href="/logout"><i class="material-icons left">exit_to_app</i>Cerrar Sesión</a></li>
            </ul>
        </div>
    </nav>

    <main class="container" style="margin-top: 60px;">
        <div style="text-align: center; margin-bottom: 60px;">
            <h4 class="page-title" style="font-size: 3rem;">Dashboard de Administrador</h4>
            <p style="color: rgba(255,255,255,0.9); font-size: 1.2rem; font-weight: 300;">Gestiona todos los usuarios del sistema</p>
        </div>

        <!-- Stats Cards -->
        <div class="row">
            <div class="col s12 m4">
                <div class="stats-card">
                    <p style="margin: 0; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 700;">Total Usuarios</p>
                    <h5 style="font-size: 3.2rem; font-weight: 900; margin: 15px 0; letter-spacing: -1px;"><%= users.length %></h5>
                    <p style="opacity: 0.95; margin: 0; font-size: 1rem;"><i class="material-icons left" style="font-size: 1.3rem;">people</i>Registrados</p>
                </div>
            </div>
            <div class="col s12 m4">
                <div class="stats-card" style="background: linear-gradient(135deg, rgba(240, 147, 251, 0.95) 0%, rgba(245, 87, 108, 0.95) 100%);">
                    <p style="margin: 0; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 700;">Administradores</p>
                    <h5 style="font-size: 3.2rem; font-weight: 900; margin: 15px 0; letter-spacing: -1px;"><%= users.filter(u => u.roles.includes('admin')).length %></h5>
                    <p style="opacity: 0.95; margin: 0; font-size: 1rem;"><i class="material-icons left" style="font-size: 1.3rem;">admin_panel_settings</i>Con rol admin</p>
                </div>
            </div>
            <div class="col s12 m4">
                <div class="stats-card" style="background: linear-gradient(135deg, rgba(79, 172, 254, 0.95) 0%, rgba(0, 242, 254, 0.95) 100%);">
                    <p style="margin: 0; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 700;">Usuarios</p>
                    <h5 style="font-size: 3.2rem; font-weight: 900; margin: 15px 0; letter-spacing: -1px;"><%= users.filter(u => !u.roles.includes('admin')).length %></h5>
                    <p style="opacity: 0.95; margin: 0; font-size: 1rem;"><i class="material-icons left" style="font-size: 1.3rem;">person</i>Con rol user</p>
                </div>
            </div>
        </div>

        <!-- Users Table -->
        <div class="row" style="margin-top: 40px;">
            <div class="col s12">
                <div class="card" style="border-radius: 24px; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
                    <div class="card-content" style="padding: 40px;">
                        <span class="card-title" style="color: #f1f5f9; font-weight: 800; font-size: 1.9rem; margin-bottom: 30px;">Gestión de Usuarios</span>
                        <table class="highlight responsive-table" style="margin-top: 20px;">
                            <thead>
                                <tr>
                                    <th style="color: #60a5fa; font-weight: 700; padding: 20px; border-bottom: 3px solid #3b82f6; text-transform: uppercase; letter-spacing: 1.5px; font-size: 0.9rem;">Nombre</th>
                                    <th style="color: #60a5fa; font-weight: 700; padding: 20px; border-bottom: 3px solid #3b82f6; text-transform: uppercase; letter-spacing: 1.5px; font-size: 0.9rem;">Email</th>
                                    <th style="color: #60a5fa; font-weight: 700; padding: 20px; border-bottom: 3px solid #3b82f6; text-transform: uppercase; letter-spacing: 1.5px; font-size: 0.9rem;">Teléfono</th>
                                    <th style="color: #60a5fa; font-weight: 700; padding: 20px; border-bottom: 3px solid #3b82f6; text-transform: uppercase; letter-spacing: 1.5px; font-size: 0.9rem;">Roles</th>
                                    <th style="color: #60a5fa; font-weight: 700; padding: 20px; border-bottom: 3px solid #3b82f6; text-transform: uppercase; letter-spacing: 1.5px; font-size: 0.9rem;">Registro</th>
                                    <th style="color: #60a5fa; font-weight: 700; padding: 20px; border-bottom: 3px solid #3b82f6; text-transform: uppercase; letter-spacing: 1.5px; font-size: 0.9rem;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% users.forEach(u => { %>
                                    <tr style="border-bottom: 1px solid rgba(255,255,255,0.05); transition: all 0.3s ease;">
                                        <td style="padding: 20px; color: #cbd5e1; font-weight: 600; font-size: 1.05rem;"><%= u.name %> <%= u.lastName || '' %></td>
                                        <td style="padding: 20px; color: #cbd5e1; font-weight: 500;"><%= u.email %></td>
                                        <td style="padding: 20px; color: #cbd5e1; font-weight: 500;"><%= u.phoneNumber || '-' %></td>
                                        <td style="padding: 20px;">
                                            <% u.roles.forEach(role => { %>
                                                <span class="role-badge <%= role === 'admin' ? 'admin' : 'user' %>">
                                                    <%= role %>
                                                </span>
                                            <% }) %>
                                        </td>
                                        <td style="padding: 20px; color: #cbd5e1; font-weight: 500;"><%= new Date(u.createdAt).toLocaleDateString() %></td>
                                        <td style="padding: 20px;">
                                            <a href="/admin/users/<%= u.id %>" class="btn-small waves-effect waves-light" style="background: linear-gradient(135deg, #3b82f6 0%, #1d4ed 100%); border-radius: 10px; box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);">
                                                <i class="material-icons">visibility</i>
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="page-footer" style="margin-top: 80px;">
        <div class="footer-copyright">
            <div class="container">© 2026 Express Mongo Auth</div>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>