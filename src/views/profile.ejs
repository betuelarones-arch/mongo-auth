<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Cuenta - Express Auth</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav>
        <div class="nav-wrapper container">
            <a href="/" class="brand-logo">🚀 ExpressAuth</a>
            <ul class="right">
                <li><a href="/dashboard"><i class="material-icons left">dashboard</i>Dashboard</a></li>
                <li><a href="/logout"><i class="material-icons left">exit_to_app</i>Cerrar Sesión</a></li>
            </ul>
        </div>
    </nav>

    <main class="container" style="margin-top: 40px;">
        <div style="text-align: center; margin-bottom: 50px;">
            <h4 class="page-title">Mi Cuenta</h4>
            <p style="color: rgba(255,255,255,0.9); font-size: 1.1rem; font-weight: 300;">Gestiona tu información personal</p>
        </div>
        
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="card red lighten-4" style="margin-bottom: 30px; border-radius: 16px;">
                <div class="card-content red-text text-darken-4" style="padding: 20px 25px;">
                    <p><i class="material-icons left" style="font-size: 1.3rem;">error</i>Error al actualizar perfil</p>
                </div>
            </div>
        <% } %>
        
        <div class="row">
            <div class="col s12 m8 offset-m2">
                <!-- Ver perfil -->
                <div id="profile-view" class="card" style="border-radius: 24px;">
                    <div class="card-content" style="padding: 40px 30px;">
                        <div style="text-align: center; margin-bottom: 40px;">
                            <div class="profile-avatar" style="width: 140px; height: 140px; font-size: 3.5rem;">
                                <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
                            </div>
                            <span class="card-title" style="color: #f1f5f9; font-weight: 800; font-size: 1.8rem;"><%= user.name %> <%= user.lastName || '' %></span>
                        </div>
                        
                        <div style="max-width: 600px; margin: 0 auto;">
                            <div class="info-card" style="display: flex; align-items: center; gap: 15px;">
                                <i class="material-icons" style="color: #60a5fa; font-size: 1.5rem;">email</i>
                                <div style="flex: 1;">
                                    <p style="color: #60a5fa; margin: 0 0 5px 0; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px;">Email</p>
                                    <p style="color: #e2e8f0; margin: 0; font-weight: 600; font-size: 1.1rem;"><%= user.email %></p>
                                </div>
                            </div>
                            
                            <div class="info-card" style="display: flex; align-items: center; gap: 15px;">
                                <i class="material-icons" style="color: #60a5fa; font-size: 1.5rem;">phone</i>
                                <div style="flex: 1;">
                                    <p style="color: #60a5fa; margin: 0 0 5px 0; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px;">Teléfono</p>
                                    <p style="color: #e2e8f0; margin: 0; font-weight: 600; font-size: 1.1rem;"><%= user.phoneNumber || 'No especificado' %></p>
                                </div>
                            </div>
                            
                            <div class="info-card" style="display: flex; align-items: center; gap: 15px;">
                                <i class="material-icons" style="color: #60a5fa; font-size: 1.5rem;">cake</i>
                                <div style="flex: 1;">
                                    <p style="color: #60a5fa; margin: 0 0 5px 0; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px;">Fecha de Nacimiento</p>
                                    <p style="color: #e2e8f0; margin: 0; font-weight: 600; font-size: 1.1rem;"><%= user.birthdate ? new Date(user.birthdate).toLocaleDateString() : 'No especificada' %></p>
                                </div>
                            </div>
                            
                            <div class="info-card" style="display: flex; align-items: center; gap: 15px;">
                                <i class="material-icons" style="color: #60a5fa; font-size: 1.5rem;">location_on</i>
                                <div style="flex: 1;">
                                    <p style="color: #60a5fa; margin: 0 0 5px 0; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px;">Dirección</p>
                                    <p style="color: #e2e8f0; margin: 0; font-weight: 600; font-size: 1.1rem;"><%= user.address || 'No especificada' %></p>
                                </div>
                            </div>
                            
                            <% if (user.url_profile) { %>
                                <div class="url-profile-card" style="display: flex; align-items: center; gap: 15px;">
                                    <i class="material-icons" style="font-size: 1.5rem;">link</i>
                                    <div style="flex: 1;">
                                        <p style="margin: 0 0 5px 0; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1.5px; opacity: 0.9;">URL de Perfil</p>
                                        <a href="<%= user.url_profile %>" target="_blank" style="color: white; font-weight: 600; word-break: break-all; text-decoration: none; border-bottom: 2px solid rgba(255,255,255,0.5);"><%= user.url_profile %></a>
                                    </div>
                                </div>
                            <% } %>
                            
                            <div class="info-card" style="display: flex; align-items: center; gap: 15px;">
                                <i class="material-icons" style="color: #60a5fa; font-size: 1.5rem;">badge</i>
                                <div style="flex: 1;">
                                    <p style="color: #60a5fa; margin: 0 0 10px 0; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px;">Rol</p>
                                    <p style="margin: 0;">
                                        <% user.roles.forEach(role => { %>
                                            <span class="role-badge <%= role === 'admin' ? 'admin' : 'user' %>">
                                                <%= role %>
                                            </span>
                                        <% }) %>
                                    </p>
                                </div>
                            </div>
                            
                            <div class="info-card" style="display: flex; align-items: center; gap: 15px;">
                                <i class="material-icons" style="color: #60a5fa; font-size: 1.5rem;">event</i>
                                <div style="flex: 1;">
                                    <p style="color: #60a5fa; margin: 0 0 5px 0; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px;">Registro</p>
                                    <p style="color: #e2e8f0; margin: 0; font-weight: 600; font-size: 1.1rem;"><%= new Date(user.createdAt).toLocaleDateString() %></p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-action" style="text-align: center; padding: 20px;">
                        <button class="btn waves-effect waves-light" onclick="showEditForm()" style="background: linear-gradient(135deg, #3b82f6 0%, #1d4ed 100%); border-radius: 12px;">
                            <i class="material-icons left">edit</i>Editar Perfil
                        </button>
                    </div>
                </div>

                <!-- Editar perfil -->
                <div id="profile-edit" style="display:none;">
                    <div class="card" style="border-radius: 24px;">
                        <div class="card-content" style="padding: 40px 30px;">
                            <span class="card-title" style="color: #60a5fa; font-weight: 600; font-size: 1.8rem; margin-bottom: 30px;">Editar Perfil</span>
                            <form method="POST" action="/profile">
                                <div class="row" style="margin-bottom: 0;">
                                    <div class="input-field col s6">
                                        <i class="material-icons prefix" style="color: #60a5fa; font-size: 1.8rem;">person</i>
                                        <input id="edit-name" name="name" type="text" class="validate" value="<%= user.name || '' %>" required style="border-bottom: 2px solid #475569; font-size: 1.1rem; padding-left: 3.5rem !important; color: #f1f5f9;">
                                        <label for="edit-name" class="active" style="font-size: 1rem; padding-left: 3.5rem !important;">Nombre</label>
                                    </div>
                                    <div class="input-field col s6">
                                        <i class="material-icons prefix" style="color: #60a5fa; font-size: 1.8rem;">person_outline</i>
                                        <input id="edit-lastName" name="lastName" type="text" class="validate" value="<%= user.lastName || '' %>" required style="border-bottom: 2px solid #475569; font-size: 1.1rem; padding-left: 3.5rem !important; color: #f1f5f9;">
                                        <label for="edit-lastName" class="active" style="font-size: 1rem; padding-left: 3.5rem !important;">Apellido</label>
                                    </div>
                                </div>
                                
                                <div class="input-field" style="margin-top: 20px;">
                                    <i class="material-icons prefix" style="color: #60a5fa; font-size: 1.8rem;">phone</i>
                                    <input id="edit-phoneNumber" name="phoneNumber" type="tel" class="validate" value="<%= user.phoneNumber || '' %>" style="border-bottom: 2px solid #475569; font-size: 1.1rem; padding-left: 3.5rem !important; color: #f1f5f9;">
                                    <label for="edit-phoneNumber" class="active" style="font-size: 1rem; padding-left: 3.5rem !important;">Teléfono</label>
                                </div>
                                
                                <div class="input-field" style="margin-top: 20px;">
                                    <i class="material-icons prefix" style="color: #60a5fa; font-size: 1.8rem;">cake</i>
                                    <input id="edit-birthdate" name="birthdate" type="date" class="validate" value="<%= user.birthdate ? user.birthdate.toISOString().split('T')[0] : '' %>" style="border-bottom: 2px solid #475569; font-size: 1.1rem; padding-left: 3.5rem !important; color: #f1f5f9;">
                                    <label for="edit-birthdate" class="active" style="font-size: 1rem; padding-left: 3.5rem !important;">Fecha de Nacimiento</label>
                                </div>
                                
                                <div class="input-field" style="margin-top: 20px;">
                                    <i class="material-icons prefix" style="color: #60a5fa; font-size: 1.8rem;">location_on</i>
                                    <input id="edit-address" name="address" type="text" class="validate" value="<%= user.address || '' %>" style="border-bottom: 2px solid #475569; font-size: 1.1rem; padding-left: 3.5rem !important; color: #f1f5f9;">
                                    <label for="edit-address" class="active" style="font-size: 1rem; padding-left: 3.5rem !important;">Dirección</label>
                                </div>
                                
                                <div class="input-field" style="margin-top: 20px;">
                                    <i class="material-icons prefix" style="color: #60a5fa; font-size: 1.8rem;">link</i>
                                    <input id="edit-url_profile" name="url_profile" type="url" class="validate" value="<%= user.url_profile || '' %>" style="border-bottom: 2px solid #475569; font-size: 1.1rem; padding-left: 3.5rem !important; color: #f1f5f9;">
                                    <label for="edit-url_profile" class="active" style="font-size: 1rem; padding-left: 3.5rem !important;">URL de Perfil</label>
                                </div>
                                
                                <div class="center-align" style="margin-top: 30px;">
                                    <button type="submit" class="btn waves-effect waves-light" style="background: linear-gradient(135deg, #3b82f6 0%, #1d4ed 100%); border-radius: 12px; margin-right: 10px;">
                                        <i class="material-icons left">save</i>Guardar Cambios
                                    </button>
                                    <button type="button" class="btn-flat waves-effect" onclick="cancelEdit()" style="color: #60a5fa; font-weight: 600;">
                                        Cancelar
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="page-footer" style="margin-top: 50px;">
        <div class="footer-copyright">
            <div class="container">© 2026 Express Mongo Auth</div>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
    <script>
        function showEditForm() {
            document.getElementById('profile-view').style.display = 'none';
            document.getElementById('profile-edit').style.display = 'block';
        }
        function cancelEdit() {
            document.getElementById('profile-edit').style.display = 'none';
            document.getElementById('profile-view').style.display = 'block';
        }
    </script>
</body>
</html>