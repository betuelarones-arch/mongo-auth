<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crear Cuenta - Express Auth</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body {
            display: flex;
            min-height: 100vh;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        main {
            width: 100%;
            max-width: 550px;
            margin: 0 auto;
        }
        .brand-logo {
            text-align: center;
            display: block;
            font-size: 2.2rem;
            margin-bottom: 5px;
            color: white !important;
        }
        .page-title {
            font-size: 1.8rem;
            margin-bottom: 3px;
        }
        .subtitle {
            color: rgba(255,255,255,0.9);
            font-size: 0.9rem;
            margin-bottom: 20px;
        }
        .card-content {
            padding: 35px 35px 25px !important;
        }
        .input-field {
            margin-top: 15px !important;
        }
        .input-field input {
            font-size: 1rem !important;
            padding-left: 3.2rem !important;
        }
        .input-field label {
            font-size: 0.9rem !important;
            padding-left: 3.2rem !important;
        }
        .input-field .prefix {
            font-size: 1.5rem !important;
        }
        .btn-large {
            height: 50px !important;
            line-height: 50px !important;
            font-size: 1.1rem !important;
            margin-top: 10px;
        }
        .card-action {
            padding: 18px 35px !important;
        }
        .card-action p {
            font-size: 0.95rem;
        }
        .error-card {
            margin-bottom: 15px;
        }
        .error-card .card-content {
            padding: 15px 20px !important;
        }
        .row {
            margin-bottom: 0;
        }
        .helper-text {
            font-size: 0.8rem !important;
            padding-left: 3.2rem !important;
        }
    </style>
</head>
<body>
    <main>
        <div class="row" style="margin-bottom: 0;">
            <div class="col s12">
                <a href="/" class="brand-logo">🚀 ExpressAuth</a>
            </div>
        </div>
        
        <div class="row" style="margin-bottom: 0;">
            <div class="col s12">
                <h4 class="page-title">Crea tu cuenta</h4>
                <p class="subtitle">Únete a nuestra plataforma</p>
            </div>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="row error-card" style="margin-bottom: 0;">
                <div class="col s12">
                    <div class="card red lighten-4" style="margin-bottom: 0; border-radius: 16px;">
                        <div class="card-content red-text text-darken-4" style="padding: 15px 20px;">
                            <p style="margin: 0;"><i class="material-icons left" style="font-size: 1.3rem;">error</i><%= error %></p>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>

        <div class="row" style="margin-bottom: 0;">
            <div class="col s12">
                <div class="card" style="border-radius: 24px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); margin: 0;">
                    <div class="card-content">
                        <form method="POST" action="/signUp">
                            <div class="row" style="margin-bottom: 0;">
                                <div class="input-field col s6" style="margin-top: 0;">
                                    <i class="material-icons prefix" style="color: #60a5fa; font-size: 1.5rem;">person</i>
                                    <input id="name" name="name" type="text" class="validate" required style="border-bottom: 2px solid #475569; font-size: 1rem; padding-left: 3.2rem !important; color: #f1f5f9;">
                                    <label for="name" style="font-size: 0.9rem; padding-left: 3.2rem !important;">Nombre</label>
                                </div>
                                <div class="input-field col s6" style="margin-top: 0;">
                                    <i class="material-icons prefix" style="color: #60a5fa; font-size: 1.5rem;">person_outline</i>
                                    <input id="lastName" name="lastName" type="text" class="validate" required style="border-bottom: 2px solid #475569; font-size: 1rem; padding-left: 3.2rem !important; color: #f1f5f9;">
                                    <label for="lastName" style="font-size: 0.9rem; padding-left: 3.2rem !important;">Apellido</label>
                                </div>
                            </div>
                            
                            <div class="row" style="margin-bottom: 0;">
                                <div class="input-field col s6" style="margin-top: 15px;">
                                    <i class="material-icons prefix" style="color: #60a5fa; font-size: 1.5rem;">email</i>
                                    <input id="email" name="email" type="email" class="validate" required style="border-bottom: 2px solid #475569; font-size: 1rem; padding-left: 3.2rem !important; color: #f1f5f9;">
                                    <label for="email" style="font-size: 0.9rem; padding-left: 3.2rem !important;">Email</label>
                                </div>
                                <div class="input-field col s6" style="margin-top: 15px;">
                                    <i class="material-icons prefix" style="color: #60a5fa; font-size: 1.5rem;">phone</i>
                                    <input id="phoneNumber" name="phoneNumber" type="tel" class="validate" required style="border-bottom: 2px solid #475569; font-size: 1rem; padding-left: 3.2rem !important; color: #f1f5f9;">
                                    <label for="phoneNumber" style="font-size: 0.9rem; padding-left: 3.2rem !important;">Teléfono</label>
                                </div>
                            </div>
                            
                            <div class="input-field" style="margin-top: 15px;">
                                <i class="material-icons prefix" style="color: #60a5fa; font-size: 1.5rem;">cake</i>
                                <input id="birthdate" name="birthdate" type="date" class="validate" required style="border-bottom: 2px solid #475569; font-size: 1rem; padding-left: 3.2rem !important; color: #f1f5f9;">
                                <label for="birthdate" style="font-size: 0.9rem; padding-left: 3.2rem !important;">Fecha de Nacimiento</label>
                            </div>
                            
                            <div class="input-field" style="margin-top: 15px;">
                                <i class="material-icons prefix" style="color: #60a5fa; font-size: 1.5rem;">location_on</i>
                                <input id="address" name="address" type="text" class="validate" style="border-bottom: 2px solid #475569; font-size: 1rem; padding-left: 3.2rem !important; color: #f1f5f9;">
                                <label for="address" style="font-size: 0.9rem; padding-left: 3.2rem !important;">Dirección</label>
                            </div>
                            
                            <div class="input-field" style="margin-top: 15px;">
                                <i class="material-icons prefix" style="color: #60a5fa; font-size: 1.5rem;">link</i>
                                <input id="url_profile" name="url_profile" type="url" class="validate" style="border-bottom: 2px solid #475569; font-size: 1rem; padding-left: 3.2rem !important; color: #f1f5f9;">
                                <label for="url_profile" style="font-size: 0.9rem; padding-left: 3.2rem !important;">URL de Perfil (opcional)</label>
                            </div>
                            
                            <div class="input-field" style="margin-top: 15px;">
                                <i class="material-icons prefix" style="color: #60a5fa; font-size: 1.5rem;">lock</i>
                                <input id="password" name="password" type="password" class="validate" required style="border-bottom: 2px solid #475569; font-size: 1rem; padding-left: 3.2rem !important; color: #f1f5f9;">
                                <label for="password" style="font-size: 0.9rem; padding-left: 3.2rem !important;">Contraseña</label>
                                <span class="helper-text" style="font-size: 0.8rem; color: #94a3b8; padding-left: 3.2rem !important;">Mín 8 caracteres, 1 mayúscula, 1 dígito, 1 carácter especial (#$%&*@)</span>
                            </div>
                            
                            <div class="center-align" style="margin-top: 25px;">
                                <button class="btn-large waves-effect waves-light" type="submit" style="width: 100%; height: 50px; font-size: 1.1rem; border-radius: 14px;">
                                    Registrarse
                                    <i class="material-icons right">person_add</i>
                                </button>
                            </div>
                        </form>
                    </div>
                    <div class="card-action" style="text-align: center; padding: 18px 35px; background: rgba(15, 23, 42, 0.5);">
                        <p style="margin: 0; color: #94a3b8; font-size: 0.95rem;">¿Ya tienes cuenta? <a href="/signIn" style="color: #60a5fa; font-weight: 700; font-size: 1rem;">Inicia sesión aquí</a></p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            M.updateTextFields();
        });
    </script>
</body>
</html>